{
  "name": "TeamTask",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique task identifier"
    },
    "checklist_id": {
      "type": "string",
      "description": "Parent checklist"
    },
    "category": {
      "type": "string",
      "enum": [
        "security",
        "testing",
        "infrastructure",
        "frontend",
        "backend",
        "database",
        "documentation",
        "marketing",
        "analytics",
        "compliance"
      ],
      "description": "Task category"
    },
    "task_name": {
      "type": "string",
      "description": "Task title"
    },
    "description": {
      "type": "string",
      "description": "Detailed task description"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "assigned_to": {
      "type": "string",
      "description": "Team member email"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "blocked",
        "cancelled"
      ],
      "default": "pending"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Task IDs this depends on"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "estimated_hours": {
      "type": "number"
    },
    "actual_hours": {
      "type": "number"
    },
    "blockers": {
      "type": "string",
      "description": "What's blocking this task"
    },
    "notes": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "task_id",
    "task_name",
    "assigned_to"
  ]
}