{
  "name": "DailyStreak",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User tracking streak"
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "Current consecutive days"
    },
    "longest_streak": {
      "type": "number",
      "default": 0,
      "description": "Best streak ever"
    },
    "last_activity_date": {
      "type": "string",
      "format": "date",
      "description": "Last active date"
    },
    "streak_frozen": {
      "type": "boolean",
      "default": false,
      "description": "Streak freeze active (purchased with coins)"
    },
    "freeze_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When freeze ends"
    },
    "streak_milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "days": {
            "type": "number"
          },
          "reached_at": {
            "type": "string"
          },
          "reward_claimed": {
            "type": "boolean"
          }
        }
      },
      "description": "Milestone achievements"
    }
  },
  "required": [
    "user_email"
  ]
}