{
  "name": "TwoFactorAuth",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User's email"
    },
    "is_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether 2FA is active"
    },
    "method": {
      "type": "string",
      "enum": [
        "authenticator",
        "sms",
        "email"
      ],
      "description": "2FA method"
    },
    "phone_number": {
      "type": "string",
      "description": "Phone for SMS 2FA"
    },
    "secret_key": {
      "type": "string",
      "description": "TOTP secret (encrypted)"
    },
    "backup_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emergency backup codes"
    },
    "last_used": {
      "type": "string",
      "format": "date-time"
    },
    "enabled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email"
  ]
}