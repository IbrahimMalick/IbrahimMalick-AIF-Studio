{
  "name": "ErrorLog",
  "type": "object",
  "properties": {
    "error_id": {
      "type": "string",
      "description": "Unique error identifier"
    },
    "user_email": {
      "type": "string",
      "description": "User who encountered error"
    },
    "error_type": {
      "type": "string",
      "description": "Error class/type"
    },
    "error_message": {
      "type": "string",
      "description": "Error description"
    },
    "stack_trace": {
      "type": "string",
      "description": "Full stack trace"
    },
    "url": {
      "type": "string",
      "description": "Page where error occurred"
    },
    "user_agent": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warning",
        "error",
        "critical"
      ],
      "default": "error"
    },
    "context": {
      "type": "object",
      "description": "Additional error context"
    },
    "resolved": {
      "type": "boolean",
      "default": false
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "error_id",
    "error_message"
  ]
}