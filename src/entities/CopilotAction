{
  "name": "CopilotAction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who triggered this action"
    },
    "session_id": {
      "type": "string",
      "description": "Chat session ID for grouping related actions"
    },
    "command": {
      "type": "string",
      "description": "Original natural language command from user"
    },
    "intent": {
      "type": "string",
      "enum": [
        "create_video",
        "generate_image",
        "schedule_post",
        "send_email",
        "create_funnel",
        "analyze_data",
        "create_automation",
        "render_video",
        "upload_file",
        "create_campaign",
        "generate_caption",
        "optimize_seo",
        "create_workflow",
        "send_notification",
        "clone_voice",
        "generate_captions",
        "spy_competitor",
        "create_lead_magnet"
      ],
      "description": "Detected intent/action type"
    },
    "params": {
      "type": "object",
      "description": "Extracted parameters from command",
      "default": {}
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "success",
        "failed",
        "cancelled",
        "pending_confirmation"
      ],
      "default": "queued",
      "description": "Current execution status"
    },
    "result": {
      "type": "object",
      "description": "Action execution result data"
    },
    "error": {
      "type": "object",
      "description": "Error details if action failed",
      "properties": {
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "AI confidence score in understanding command (0-1)"
    },
    "requires_confirmation": {
      "type": "boolean",
      "default": true,
      "description": "Whether user must confirm before execution"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When user confirmed the action"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When execution started"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When execution finished"
    },
    "execution_time_ms": {
      "type": "number",
      "description": "Total execution time in milliseconds"
    },
    "entity_created_id": {
      "type": "string",
      "description": "ID of entity created by this action (e.g., video project ID)"
    },
    "entity_created_type": {
      "type": "string",
      "description": "Type of entity created (e.g., 'VideoProject', 'ScheduledPost')"
    },
    "ai_model_used": {
      "type": "string",
      "description": "AI model used for intent detection",
      "default": "gpt-4"
    },
    "tokens_used": {
      "type": "number",
      "description": "Tokens consumed for this action"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "Number of retry attempts"
    },
    "parent_action_id": {
      "type": "string",
      "description": "If this is a retry, ID of original action"
    },
    "user_feedback": {
      "type": "object",
      "description": "User feedback on action result",
      "properties": {
        "was_helpful": {
          "type": "boolean"
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "user_email",
    "command",
    "intent",
    "params"
  ]
}