{
  "name": "PaymentMethod",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User's email"
    },
    "stripe_payment_method_id": {
      "type": "string",
      "description": "Stripe PM ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "card",
        "bank_account",
        "paypal"
      ],
      "description": "Payment type"
    },
    "card_brand": {
      "type": "string",
      "description": "Visa, Mastercard, etc."
    },
    "card_last4": {
      "type": "string",
      "description": "Last 4 digits"
    },
    "card_exp_month": {
      "type": "number"
    },
    "card_exp_year": {
      "type": "number"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "billing_address": {
      "type": "object",
      "properties": {
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "added_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "stripe_payment_method_id",
    "type"
  ]
}