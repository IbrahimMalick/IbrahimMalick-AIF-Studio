{
  "name": "PasswordReset",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User requesting reset"
    },
    "token": {
      "type": "string",
      "description": "Reset token"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Token expiration"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "Whether token was used"
    },
    "used_at": {
      "type": "string",
      "format": "date-time"
    },
    "ip_address": {
      "type": "string",
      "description": "Request IP"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser info"
    }
  },
  "required": [
    "user_email",
    "token",
    "expires_at"
  ]
}