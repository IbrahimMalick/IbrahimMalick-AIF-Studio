{
  "name": "ContentCalendarEvent",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who owns this event"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "social_post",
        "email_campaign",
        "blog_post",
        "video_publish",
        "ad_campaign",
        "webinar",
        "product_launch",
        "custom"
      ],
      "description": "Type of content event"
    },
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time",
      "description": "When content is scheduled"
    },
    "scheduled_time_optimal": {
      "type": "boolean",
      "default": false,
      "description": "Whether scheduled at AI-suggested optimal time"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Platforms this content goes to"
    },
    "content_preview": {
      "type": "string",
      "description": "Preview of content"
    },
    "content_url": {
      "type": "string",
      "description": "Media URL if applicable"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Preview thumbnail"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "published",
        "failed",
        "cancelled"
      ],
      "default": "draft",
      "description": "Event status"
    },
    "source_entity_type": {
      "type": "string",
      "enum": [
        "ScheduledPost",
        "AIContentGeneration",
        "ContentRepurposing",
        "EmailCampaign",
        "AdCampaign",
        "CTVProject",
        "BlogPost",
        "custom"
      ],
      "description": "Original source entity"
    },
    "source_entity_id": {
      "type": "string",
      "description": "ID of source entity"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether AI generated this content"
    },
    "ai_suggestion_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether user accepted AI timing suggestion"
    },
    "original_suggested_time": {
      "type": "string",
      "format": "date-time",
      "description": "AI's original suggested time"
    },
    "color": {
      "type": "string",
      "description": "Calendar event color",
      "default": "#FFD700"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Event tags for filtering"
    },
    "campaign_id": {
      "type": "string",
      "description": "Parent campaign ID if part of campaign"
    },
    "campaign_name": {
      "type": "string",
      "description": "Campaign name"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Content priority"
    },
    "engagement_prediction": {
      "type": "object",
      "properties": {
        "estimated_reach": {
          "type": "number"
        },
        "estimated_engagement_rate": {
          "type": "number"
        },
        "optimal_score": {
          "type": "number"
        },
        "conflict_score": {
          "type": "number"
        }
      },
      "description": "AI predictions for this slot"
    },
    "actual_performance": {
      "type": "object",
      "properties": {
        "actual_reach": {
          "type": "number"
        },
        "actual_engagement_rate": {
          "type": "number"
        },
        "clicks": {
          "type": "number"
        },
        "conversions": {
          "type": "number"
        }
      },
      "description": "Real performance metrics"
    },
    "auto_publish_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether to auto-publish at scheduled time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When content was actually published"
    },
    "published_urls": {
      "type": "object",
      "description": "URLs where content was published"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether reminder notification was sent"
    },
    "reminder_hours_before": {
      "type": "number",
      "default": 24,
      "description": "Hours before event to send reminder"
    },
    "collaborators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User emails with access to this event"
    },
    "approval_required": {
      "type": "boolean",
      "default": false,
      "description": "Needs approval before publishing"
    },
    "approved_by": {
      "type": "string",
      "description": "User who approved"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "event_type",
    "title",
    "scheduled_date"
  ]
}