{
  "name": "ResearchDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded document URL"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "pdf",
        "docx",
        "txt",
        "md"
      ],
      "description": "Document format"
    },
    "extracted_text": {
      "type": "string",
      "description": "Extracted text content"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated summary"
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Main takeaways"
    },
    "entities_extracted": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        }
      }
    },
    "qa_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "file_url"
  ]
}