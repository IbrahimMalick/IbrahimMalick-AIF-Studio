{
  "name": "LeadResponse",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Lead who responded"
    },
    "sequence_id": {
      "type": "string",
      "description": "LeadNurtureSequence ID"
    },
    "touchpoint_number": {
      "type": "number",
      "description": "Which touchpoint they responded to"
    },
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "email",
        "call",
        "web"
      ],
      "description": "Response channel"
    },
    "response_text": {
      "type": "string",
      "description": "Lead's message"
    },
    "response_type": {
      "type": "string",
      "enum": [
        "direct_reply",
        "link_click",
        "form_submit",
        "phone_call",
        "meeting_booked"
      ],
      "description": "Type of response"
    },
    "sentiment": {
      "type": "number",
      "minimum": -1,
      "maximum": 1,
      "description": "Response sentiment (-1 to 1)"
    },
    "sentiment_label": {
      "type": "string",
      "enum": [
        "very_positive",
        "positive",
        "neutral",
        "negative",
        "very_negative"
      ],
      "description": "Sentiment category"
    },
    "intent": {
      "type": "string",
      "enum": [
        "interested",
        "needs_more_info",
        "ready_to_buy",
        "not_interested",
        "bad_timing",
        "price_concern",
        "question",
        "complaint"
      ],
      "description": "Detected intent"
    },
    "intent_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "AI confidence in intent detection"
    },
    "urgency_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "How urgent/hot the lead is"
    },
    "entities_extracted": {
      "type": "object",
      "properties": {
        "budget_mentioned": {
          "type": "string"
        },
        "timeline_mentioned": {
          "type": "string"
        },
        "objections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "positive_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Extracted information from response"
    },
    "ai_analysis": {
      "type": "object",
      "properties": {
        "buying_signals": {
          "type": "number",
          "description": "Strength of buying intent (0-100)"
        },
        "objection_level": {
          "type": "string",
          "enum": [
            "none",
            "soft",
            "hard"
          ]
        },
        "engagement_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "very_high"
          ]
        },
        "next_best_action": {
          "type": "string"
        },
        "recommended_follow_up": {
          "type": "string"
        },
        "recommended_delay_hours": {
          "type": "number"
        }
      },
      "description": "AI analysis of response"
    },
    "triggered_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_type": {
            "type": "string"
          },
          "action_description": {
            "type": "string"
          },
          "workflow_id": {
            "type": "string"
          },
          "executed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Automated actions triggered by this response"
    },
    "sequence_adjustment": {
      "type": "object",
      "properties": {
        "paused_sequence": {
          "type": "boolean"
        },
        "accelerated_sequence": {
          "type": "boolean"
        },
        "switched_to_variant": {
          "type": "string"
        },
        "added_touchpoints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "removed_touchpoints": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "adjustment_reason": {
          "type": "string"
        }
      },
      "description": "How sequence was adjusted based on response"
    },
    "response_time_hours": {
      "type": "number",
      "description": "Hours between touchpoint and response"
    },
    "human_handoff_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether human should take over"
    },
    "handoff_reason": {
      "type": "string",
      "description": "Why human handoff is needed"
    },
    "processed": {
      "type": "boolean",
      "default": false,
      "description": "Whether AI processed this response"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "lead_id",
    "sequence_id",
    "channel",
    "response_text"
  ]
}