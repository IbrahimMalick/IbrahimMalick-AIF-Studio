{
  "name": "PartnerAffiliate",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Partner's account email"
    },
    "partner_type": {
      "type": "string",
      "enum": [
        "affiliate",
        "reseller",
        "strategic"
      ],
      "default": "affiliate",
      "description": "Partner track"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended",
        "terminated"
      ],
      "default": "pending",
      "description": "Account status"
    },
    "tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "premier"
      ],
      "default": "bronze",
      "description": "Performance tier"
    },
    "commission_rate_recurring": {
      "type": "number",
      "default": 30,
      "description": "Recurring commission % (30% default for affiliates)"
    },
    "commission_rate_addon": {
      "type": "number",
      "default": 10,
      "description": "Add-on commission % (10% default)"
    },
    "revenue_share_percent": {
      "type": "number",
      "default": 25,
      "description": "Revenue share % for resellers (25-35%)"
    },
    "company_name": {
      "type": "string",
      "description": "Company/business name"
    },
    "website": {
      "type": "string",
      "description": "Partner website URL"
    },
    "paypal_email": {
      "type": "string",
      "description": "PayPal payment email"
    },
    "stripe_connect_id": {
      "type": "string",
      "description": "Stripe Connect account ID for resellers"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "paypal",
        "stripe",
        "bank_transfer",
        "invoice"
      ],
      "default": "paypal",
      "description": "How partner gets paid"
    },
    "tax_form_url": {
      "type": "string",
      "description": "W-9 or tax document URL"
    },
    "tax_id": {
      "type": "string",
      "description": "Tax ID / EIN"
    },
    "billing_address": {
      "type": "object",
      "properties": {
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      },
      "description": "Billing address"
    },
    "total_referrals": {
      "type": "number",
      "default": 0,
      "description": "Total signups referred"
    },
    "total_conversions": {
      "type": "number",
      "default": 0,
      "description": "Signups that converted to paid"
    },
    "active_customers": {
      "type": "number",
      "default": 0,
      "description": "Currently paying customers"
    },
    "mrr_influenced": {
      "type": "number",
      "default": 0,
      "description": "Monthly recurring revenue under this partner"
    },
    "total_earned_usd": {
      "type": "number",
      "default": 0,
      "description": "Lifetime commissions earned"
    },
    "total_paid_usd": {
      "type": "number",
      "default": 0,
      "description": "Commissions paid out"
    },
    "pending_balance_usd": {
      "type": "number",
      "default": 0,
      "description": "Unpaid commission balance"
    },
    "next_payout_date": {
      "type": "string",
      "format": "date-time",
      "description": "Next scheduled payout"
    },
    "white_label_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Reseller white-label access"
    },
    "deal_reg_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Can register deals"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Certifications completed",
      "default": []
    },
    "approved_by": {
      "type": "string",
      "description": "Admin who approved partner"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Approval timestamp"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    }
  },
  "required": [
    "user_email",
    "partner_type"
  ]
}