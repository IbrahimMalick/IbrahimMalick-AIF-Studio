{
  "name": "GoogleAdsConfig",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who owns this Google Ads connection"
    },
    "customer_id": {
      "type": "string",
      "description": "Google Ads Customer ID (123-456-7890)"
    },
    "manager_customer_id": {
      "type": "string",
      "description": "Manager account ID if using MCC"
    },
    "access_token": {
      "type": "string",
      "description": "Encrypted OAuth access token"
    },
    "refresh_token": {
      "type": "string",
      "description": "Encrypted OAuth refresh token"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Token expiration timestamp"
    },
    "developer_token": {
      "type": "string",
      "description": "Google Ads API developer token"
    },
    "account_name": {
      "type": "string",
      "description": "Account display name"
    },
    "account_currency": {
      "type": "string",
      "default": "USD",
      "description": "Account currency code"
    },
    "account_timezone": {
      "type": "string",
      "description": "Account timezone"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "suspended",
        "cancelled"
      ],
      "description": "Billing status"
    },
    "is_connected": {
      "type": "boolean",
      "default": false,
      "description": "Connection status"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "error",
        "expired",
        "disconnected"
      ],
      "default": "active",
      "description": "Overall connection health"
    },
    "conversion_tracking": {
      "type": "object",
      "properties": {
        "conversion_id": {
          "type": "string"
        },
        "conversion_label": {
          "type": "string"
        },
        "gtag_installed": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Conversion tracking setup"
    },
    "auto_sync_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Auto-sync campaign data"
    },
    "sync_frequency_hours": {
      "type": "number",
      "default": 6,
      "description": "Sync interval in hours"
    },
    "last_sync": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful sync"
    },
    "error_message": {
      "type": "string",
      "description": "Last error details"
    }
  },
  "required": [
    "user_email",
    "customer_id"
  ]
}